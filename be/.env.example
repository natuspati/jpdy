# Copy this file to be/.env for local development. It is intentionally not tracked.
BE_ENVIRONMENT=local
BE_SECRET_KEY=replace-with-a-local-development-secret
BE_HOST=0.0.0.0
BE_PORT=8000
BE_RELOAD=true
BE_ALLOWED_HOSTS=["http://localhost:8080"]

# SQLite stays local to be/. Run migrations at API startup for a fresh database.
BE_DB_APPLY_MIGRATIONS=true
BE_DB_DRIVER=sqlite+aiosqlite
BE_DB_SYNC_DRIVER=sqlite
BE_DB_NAME=jpdy.db

BE_REDIS_URL=redis://localhost:6379/0

# FastAPI validates/writes uploads here. Nginx must mount same directory read-only and serve it
# at /media/.
BE_MEDIA_ROOT=media
BE_MEDIA_URL_PREFIX=/media
