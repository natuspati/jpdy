# Copy this file to be/.env for local development. It is intentionally not tracked.
BE_ENVIRONMENT=local
BE_SECRET_KEY=replace-with-a-local-development-secret
BE_HOST=0.0.0.0
BE_PORT=8000
BE_RELOAD=true
BE_ALLOWED_HOSTS=["http://localhost:8080"]

# SQLite remains default local/test dialect. Compose uses PostgreSQL and runs
# migrations through its dedicated `migrate` service before backend starts.
BE_DB_APPLY_MIGRATIONS=true
BE_DB_DRIVER=sqlite+aiosqlite
BE_DB_SYNC_DRIVER=sqlite
BE_DB_NAME=jpdy.db
# PostgreSQL example:
# BE_DB_DRIVER=postgresql+asyncpg
# BE_DB_SYNC_DRIVER=postgresql+psycopg
# BE_DB_HOST=localhost
# BE_DB_PORT=5432
# BE_DB_USER=jpdy
# BE_DB_PASSWORD=replace-me
# BE_DB_NAME=jpdy

BE_REDIS_URL=redis://localhost:6379/0
# Required when using more than one Uvicorn worker/process.
BE_SOCKETIO_REDIS_URL=redis://localhost:6379/0
BE_SOCKETIO_REDIS_CHANNEL=jpdy.socketio

# FastAPI validates/writes uploads here. Nginx must mount same directory read-only and serve it
# at /media/.
BE_MEDIA_ROOT=media
BE_MEDIA_URL_PREFIX=/media
