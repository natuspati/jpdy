FROM oven/bun:1.3.8 AS frontend-build

WORKDIR /app/fe

COPY fe/package.json fe/bun.lock ./
RUN bun install --frozen-lockfile

COPY fe/ ./

ARG VITE_API_URL=/api/v1
ARG VITE_SOCKET_URL=
ARG VITE_SOCKET_PATH=/ws
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SOCKET_URL=$VITE_SOCKET_URL \
    VITE_SOCKET_PATH=$VITE_SOCKET_PATH

RUN bun run build

FROM nginx:1.27-alpine

COPY deployment/nginx/nginx.local.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/fe/dist /usr/share/nginx/html

EXPOSE 80
