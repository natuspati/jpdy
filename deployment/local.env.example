# Copy to deployment/local.env.
# Pass this file to Compose with --env-file deployment/local.env.

POSTGRES_DB=jpdy
POSTGRES_USER=jpdy
POSTGRES_PASSWORD=local-compose-postgres-password

BE_ENVIRONMENT=local
BE_SECRET_KEY=local-compose-development-secret
BE_RELOAD=false
BE_PORT=8000
BE_WORKERS_COUNT=1
BE_ALLOWED_HOSTS=["http://localhost:8080"]
BE_DB_APPLY_MIGRATIONS=false
BE_DB_DRIVER=postgresql+asyncpg
BE_DB_SYNC_DRIVER=postgresql+psycopg
BE_DB_HOST=postgres
BE_DB_PORT=5432
BE_DB_USER=jpdy
BE_DB_PASSWORD=local-compose-postgres-password
BE_DB_NAME=jpdy
BE_REDIS_URL=redis://redis:6379/0
BE_SOCKETIO_REDIS_URL=redis://redis:6379/0
BE_SOCKETIO_REDIS_CHANNEL=jpdy.socketio
BE_MEDIA_ROOT=/media

VITE_API_URL=/api/v1
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/ws
NGINX_HOST_PORT=8080
