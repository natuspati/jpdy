# Template for deployment/prod.env. scripts/jpdy.sh fills the __PLACEHOLDERS__
# on first run; edit prod.env afterwards if you need to change anything.

PUBLIC_URL=https://jpdy.__TAILNET__
TS_AUTHKEY=__TS_AUTHKEY__
BE_REPLICAS=2

POSTGRES_DB=jpdy
POSTGRES_USER=jpdy
POSTGRES_PASSWORD=__DB_PASSWORD__

BE_ENVIRONMENT=prod
# Must be shared by all replicas, or tokens from one are rejected by another.
BE_SECRET_KEY=__SECRET_KEY__
BE_REGISTRATION_CODE=__INVITE_CODE__
BE_RELOAD=false
BE_PORT=8000
BE_WORKERS_COUNT=1
BE_ALLOWED_HOSTS=["https://jpdy.__TAILNET__","http://localhost:8080"]
BE_DB_APPLY_MIGRATIONS=false
BE_DB_DRIVER=postgresql+asyncpg
BE_DB_SYNC_DRIVER=postgresql+psycopg
BE_DB_HOST=postgres
BE_DB_PORT=5432
BE_DB_USER=jpdy
BE_DB_PASSWORD=__DB_PASSWORD__
BE_DB_NAME=jpdy
BE_REDIS_URL=redis://redis:6379/0
BE_SOCKETIO_REDIS_URL=redis://redis:6379/0
BE_SOCKETIO_REDIS_CHANNEL=jpdy.socketio
BE_MEDIA_ROOT=/media

VITE_API_URL=/api/v1
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/ws
NGINX_HOST_PORT=8080
